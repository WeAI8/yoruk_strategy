{
  "name": "yoruk-strategy-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Yoruk Games - Kadim Bozkir Strateji Oyunu Multi-Repo Workspace",
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev --workspace=@yorukstrategy/server",
    "dev:client": "npm run dev --workspace=@yorukstrategy/client"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "yoruk-games",
    "strategy",
    "nomadic",
    "turan",
    "isometric"
  ],
  "author": "Yoruk Games Studio",
  "license": "UNLICENSED"
}
