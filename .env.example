GAME_CLIENT_PORT=3001
GAME_SERVER_PORT=8081

STRATEGY_DB_NAME=yoruk_strategy_db
STRATEGY_DB_USER=strategy_admin
STRATEGY_DB_PASSWORD=strategy_secret_password

# Yoruk Games Umbrella Platform SSO Endpoint
PLATFORM_AUTH_URL=http://host.docker.internal:8080/api/v1/auth/exchange-ticket
CLIENT_ID=game-client-strategy-01
CLIENT_SECRET=yoruk_strategy_secret_key
ALLOW_DEV_TICKETS=true
